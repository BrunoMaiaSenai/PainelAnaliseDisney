<Window x:Class="PainelAnaliseDisney.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PainelAnaliseDisney"
        mc:Ignorable="d"
        Title="Painel de Analise Disney" Height="589" Width="800">
    
    
    <!-- Estilos e recursos da janela -->
    <Window.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" >
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Efeito Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- StackPanel para busca de locais e resultados -->
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Buscar Filmes:" FontWeight="Bold" FontSize="14" Margin="0,0,0,5" />

            <UniformGrid Columns="2">
                <Button Style="{StaticResource ButtonStyle}" Content="Buscar" FontWeight="Bold" Margin="0,10,5,10" Height="38" Command="{Binding BuscarCommand}" />
                <Button Style="{StaticResource ButtonStyle}" Content="Limpar" FontWeight="Bold" Margin="5,10,0,10" Height="38" Command="{Binding LimparCommand}" />
            </UniformGrid>
            <!-- Lista de Filmes encontrados -->
            <TextBlock Text="Filmes Encontrados:" FontWeight="Bold" FontSize="12" Margin="0,5" />
            <ListBox ItemsSource="{Binding Dados}" Height="250">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Id}" FontWeight="Bold" Foreground="DarkBlue" Margin="0,0,15,0" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Logradouro}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text=", N°: " FontWeight="Bold" Margin="5,0,0,0"/>
                                        <TextBlock Text="{Binding Numero}" FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Bairro: " Foreground="Gray"/>
                                        <TextBlock Text="{Binding Bairro}" Margin="0,0,10,0"/>
                                        <TextBlock Text="CEP: " Foreground="Gray"/>
                                        <TextBlock Text="{Binding CEP}" Margin="0,0,10,0"/>
                                        <TextBlock Text="Lat: " FontSize="11" Foreground="Gray"/>
                                        <TextBlock Text="{Binding Latitude}" FontSize="11" Foreground="Gray" Margin="0,0,10,0"/>
                                        <TextBlock Text="Long: " FontSize="11" Foreground="Gray"/>
                                        <TextBlock Text="{Binding Longitude}" FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        
        

    </Grid>
</Window>
