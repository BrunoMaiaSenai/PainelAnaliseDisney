<Window x:Class="PainelAnaliseDisney.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PainelAnaliseDisney"
        mc:Ignorable="d"
        Title="Painel de Análise Disney - Relatórios" Height="650" Width="850" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#F0F4F8" BorderBrush="#D0D9E0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="10">
            <StackPanel Margin="10">

                <Border Background="#F0F4F8" BorderBrush="#D0D9E0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Insights e Estatísticas do Painel" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Total de Personagens Carregados: " FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalPersonagens}" Foreground="#2563EB" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Personagens Populares na TV: " FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PersonagensNaTv}" Foreground="#16A34A" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Destaque (Mais Filmes): " FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PersonagemDestaque}" Foreground="#EA580C" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                    <Button Content="Buscar Dados" 
            Command="{Binding BuscarCommand}" 
            Width="120" Height="35" 
            Margin="5" 
            Background="#2563EB" Foreground="White" FontWeight="Bold"/>

                    <Button Content="Limpar" 
            Command="{Binding LimparCommand}" 
            Width="120" Height="35" 
            Margin="5" 
            Background="#64748B" Foreground="White" FontWeight="Bold"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="15,5,15,15">
            <TextBlock Text="Carregando e integrando dados com Firebase... Por favor, aguarde." 
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0"
                       FontSize="14" FontWeight="SemiBold" Foreground="#007ACC"
                       Visibility="{Binding IsCarregando, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <ListBox ItemsSource="{Binding Dados}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="#EAEAEA" BorderThickness="1">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Border Padding="15">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                        Width="70"
                        Height="70"
                        CornerRadius="5"
                        Background="#EEE"
                        VerticalAlignment="Center">

                                    <Image Source="{Binding ImageUrl,
                                    TargetNullValue={x:Null},
                                    FallbackValue={x:Null}}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                                    <TextBlock Text="ID"
                               FontSize="10"
                               Foreground="Gray"
                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding Id}"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="#007ACC"
                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">

                                    <Grid>
                                        <TextBlock Text="{Binding Name}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="#222"/>

                                        <TextBlock Text="{Binding Timestamp,
                                          StringFormat='Sincronizado em: \{0\}'}"
                                   FontSize="11"
                                   Foreground="DarkGreen"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <WrapPanel Margin="0,5,0,0">
                                        <TextBlock Text="Filmes: "
                                   FontWeight="SemiBold"
                                   Foreground="#555"/>

                                        <TextBlock Text="{Binding Films,
                                          TargetNullValue='Nenhum'}"
                                   Margin="0,0,15,0"
                                   Foreground="#333"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="500"/>
                                    </WrapPanel>

                                    <WrapPanel Margin="0,2,0,0">

                                        <TextBlock Text="Séries de TV: "
                                   FontWeight="SemiBold"
                                   Foreground="#555"/>

                                        <TextBlock Text="{Binding TvShows,
                                          TargetNullValue='Nenhuma'}"
                                   Margin="0,0,15,0"
                                   Foreground="#333"/>

                                        <TextBlock Text="Curtas: "
                                   FontWeight="SemiBold"
                                   Foreground="#555"/>

                                        <TextBlock Text="{Binding ShortFilms,
                                          TargetNullValue='Nenhum'}"
                                   Foreground="#333"/>
                                    </WrapPanel>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>